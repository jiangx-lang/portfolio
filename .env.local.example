# 阿里云通义千问 DashScope API Key（与 OpenAI SDK 兼容调用）
QWEN_API_KEY=你的阿里云DashScope_Key放这里
# 可选：QWEN_MODEL=qwen-plus

# 已弃用：# GROQ_API_KEY=
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Publishable（sb_publishable_…）给 Python/服务端读表；Secret（sb_secret_…）仅服务端高权限
SUPABASE_KEY=sb_publishable_YOUR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=sb_secret_YOUR_SECRET_KEY
NEXT_PUBLIC_APP_NAME=MF Holdings Dashboard
NEXT_PUBLIC_SHOW_QDII=true
