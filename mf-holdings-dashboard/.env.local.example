GROQ_API_KEY=your_groq_key_here
NEXT_PUBLIC_APP_NAME=MF Holdings Dashboard

# 锦城 Streamlit（WMP/笔记/播客/管理员、导航「锦城系统」）
# 勿填成与 Next 站点完全相同的首页 URL，否则入口页 <a> 跳转等同当前页、表现为「点了没反应」
NEXT_PUBLIC_STREAMLIT_URL=https://streamlit.atlasallocations.com

# Supabase（Dashboard → Settings → API）
# - Publishable key（sb_publishable_…）：可公开，遵守 RLS（旧称 anon）
# - Secret key（sb_secret_…）：仅服务端，高权限（旧称 service_role）；勿加 NEXT_PUBLIC_
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=sb_publishable_YOUR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=sb_secret_YOUR_SECRET_KEY
NEXT_PUBLIC_SHOW_QDII=true

# 浏览器端（市场笔记 / 播客 / 每日报告）：URL + Publishable，勿填 Secret
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_YOUR_PUBLISHABLE_KEY

# 管理员后台简易密码（会暴露在前端包内，生产请改服务端鉴权）
NEXT_PUBLIC_ADMIN_PASSWORD=your_secure_password

# Optional: upgrade path
# ANTHROPIC_API_KEY=your_key_here
# PUBLICCOM_API_KEY=your_key_here
# PUBLICCOM_ACCOUNT_ID=your_account_id
