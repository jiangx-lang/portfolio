GROQ_API_KEY=your_groq_key_here
NEXT_PUBLIC_APP_NAME=MF Holdings Dashboard

# 锦城 Streamlit（WMP/笔记/播客/管理员、导航「锦城系统」）
# 勿填成与 Next 站点完全相同的首页 URL，否则入口页 <a> 跳转等同当前页、表现为「点了没反应」
NEXT_PUBLIC_STREAMLIT_URL=https://streamlit.atlasallocations.com

# Supabase（QDII 净值 + 基金列表，服务端 API）
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_anon_key
# 可选：管理员后台「访问统计」读库用（勿提交、勿暴露到 NEXT_PUBLIC_*）。执行 supabase_analytics.sql 后配置。
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SHOW_QDII=true

# Supabase 浏览器端（市场笔记 / 播客 / 每日报告；通常与上面 URL + anon key 相同）
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# 管理员后台简易密码（会暴露在前端包内，生产请改服务端鉴权）
NEXT_PUBLIC_ADMIN_PASSWORD=your_secure_password

# Optional: upgrade path
# ANTHROPIC_API_KEY=your_key_here
# PUBLICCOM_API_KEY=your_key_here
# PUBLICCOM_ACCOUNT_ID=your_account_id
