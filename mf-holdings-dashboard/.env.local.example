# 阿里云通义千问（DashScope OpenAI 兼容），见 https://help.aliyun.com/zh/model-studio/developer-reference/use-qwen-by-calling-api
QWEN_API_KEY=your_dashscope_api_key_here
# 可选：qwen-plus（默认）| qwen-turbo | qwen-max
# QWEN_MODEL=qwen-plus

# 已弃用：# GROQ_API_KEY=

NEXT_PUBLIC_APP_NAME=MF Holdings Dashboard

# WMP 净值 CSV（仅服务端 /api/wmp 读取；生产默认 /root/portfolio/data/wmp_history.csv）
# WMP_CSV_PATH=D:\\portoflio for mrf\\data\\wmp_history.csv
# 管理端「立即抓取」调用的 Python（可选；默认 python3 + mf-holdings-dashboard/scripts/scrape_wmp.py）
# WMP_SCRAPER_PYTHON=python3
# WMP_SCRAPER_SCRIPT=/root/portfolio/mf-holdings-dashboard/scripts/scrape_wmp.py

# Supabase（Dashboard → Settings → API）
# - Publishable key（sb_publishable_…）：可公开，遵守 RLS（旧称 anon）
# - Secret key（sb_secret_…）：仅服务端，高权限（旧称 service_role）；勿加 NEXT_PUBLIC_
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=sb_publishable_YOUR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=sb_secret_YOUR_SECRET_KEY
NEXT_PUBLIC_SHOW_QDII=true

# 浏览器端（市场笔记 / 播客 / 每日报告）：URL + Publishable，勿填 Secret
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_YOUR_PUBLISHABLE_KEY

# 管理员后台简易密码（会暴露在前端包内，生产请改服务端鉴权）
NEXT_PUBLIC_ADMIN_PASSWORD=your_secure_password

# Optional: upgrade path
# ANTHROPIC_API_KEY=your_key_here
# PUBLICCOM_API_KEY=your_key_here
# PUBLICCOM_ACCOUNT_ID=your_account_id
